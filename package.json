{
  "name": "owners-office",
  "version": "0.1.0",
  "description": "OWNER'S OFFICE — personal business management system: finance, products & services as employees, ventures, goals, productivity and audit.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "test:e2e": "node tests/e2e/run.js",
    "test:e2e:pages": "npm run build:pages && node tests/e2e/run.js --dist",
    "build:pages": "node scripts/build-pages.js",
    "check": "node scripts/check.js",
    "build:worker": "node scripts/build-worker.js",
    "dev:worker": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy"
  },
  "devDependencies": {
    "sql.js": "1.14.2",
    "wrangler": "^4.0.0"
  }
}
